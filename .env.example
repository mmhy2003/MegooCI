# MegooCI Configuration
# Copy this file to .env and adjust values

# Postgres container credentials (used by the `db` service in docker-compose)
POSTGRES_USER=megooci
POSTGRES_PASSWORD=megooci
POSTGRES_DB=megooci

# Database DSN used by the backend / Celery services.
# When running via docker compose, the hostname must be the service name (`db`).
# When running the backend on the host, use `localhost` instead.
MEGOOCI_DATABASE_URL=postgresql+asyncpg://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB

# Redis
MEGOOCI_REDIS_URL=redis://redis:6379/0

# Meilisearch
MEILI_MASTER_KEY=megooci-meili-master-key
MEGOOCI_MEILISEARCH_URL=http://meilisearch:7700
MEGOOCI_MEILISEARCH_API_KEY=$MEILI_MASTER_KEY

# Security (CHANGE THESE IN PRODUCTION!)
MEGOOCI_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
MEGOOCI_JWT_SECRET=change-me-jwt-secret-use-a-random-64-char-string

# Auth
MEGOOCI_SIGNUP_ENABLED=true
MEGOOCI_DEFAULT_ROLE=viewer

# Admin seed — auto-create an admin user on clean first startup.
# Both must be set. Ignored if users already exist in the database.
# Remove or leave blank after the first startup for security.
MEGOOCI_ADMIN_EMAIL=
MEGOOCI_ADMIN_PASSWORD=

# Storage
MEGOOCI_STORAGE_ROOT=/var/lib/megooci
MEGOOCI_ARTIFACT_RETENTION_BUILDS=50
MEGOOCI_ARTIFACT_RETENTION_DAYS=30

# AI Features
MEGOOCI_AI_ENABLED=true
MEGOOCI_AI_PROVIDER=openai
MEGOOCI_AI_API_KEY=
MEGOOCI_AI_MODEL=
MEGOOCI_AI_BASE_URL=

# Email / SMTP is now configured via the UI: Admin > Integrations > Notification Channels.
MEGOOCI_INVITE_EXPIRY_HOURS=72

# Server
MEGOOCI_PUBLIC_URL=http://localhost:8000
MEGOOCI_LOG_LEVEL=INFO

# Frontend
# Browser-side API base URL (reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Registry (embedded OCI/Docker registry — PRD §6.13)
MEGOOCI_REGISTRY_ENABLED=true
MEGOOCI_REGISTRY_HOST=localhost
MEGOOCI_REGISTRY_PORT=0
MEGOOCI_REGISTRY_STORAGE_PATH=${MEGOOCI_STORAGE_ROOT}/registry
MEGOOCI_REGISTRY_MAX_UPLOAD_MB=2048
MEGOOCI_REGISTRY_ALLOW_ANONYMOUS_PULL=false
MEGOOCI_REGISTRY_GC_CRON=0 3 * * *

# -----------------------------------------------------------------------------
# megooci-agent (PRD §6.3 / F-3.4)
#
# The agent is run as a standalone `docker run` container started by
# `make agent-up`. Its agent ID and token are passed as CLI flags
# (`make agent-up ID=<uuid> TOKEN=<token>`) rather than env vars, so they
# never end up in .env, .bash_history, or `docker inspect` of unrelated
# services.
#
# The Makefile only reads `MEGOOCI_AGENT_VERSION` from here — it's used as
# the Docker image tag when building.
# -----------------------------------------------------------------------------
MEGOOCI_AGENT_VERSION=0.1.0