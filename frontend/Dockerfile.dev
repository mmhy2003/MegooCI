# syntax=docker/dockerfile:1.7

# =============================================================================
# Development Dockerfile for MegooCI Frontend
#
# Optimised for fast iteration with hot-reload. Source code is bind-mounted
# by docker compose, so the image only needs to contain installed dependencies
# and tooling.
#
# Build:  docker build -f Dockerfile.dev -t megooci-frontend:dev ./frontend
# Run:    docker compose up frontend
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# Tooling needed by some native node modules on alpine + watch mode
RUN apk add --no-cache libc6-compat

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    # Enable polling for reliable file-watching across bind mounts on
    # Windows / macOS / WSL where inotify events can be flaky.
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; \
    else npm install --no-audit --no-fund; fi

# Source is bind-mounted in compose; this copy is only a fallback so the
# image is usable standalone.
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
